								android:text="العودة إلى مواقع التواصل "
								android:textSize="25sp"
								android:textColor="#FFFFFF" />
							<Button
								android:id="@+id/button3"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:layout_marginTop="10dp"
								android:layout_marginBottom="12dp"
								android:padding="8dp"
								android:text="مسح التوقيتات "
								android:textSize="25sp"
								android:textColor="#FFFFFF" />
							<LinearLayout
								android:id="@+id/linear12"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:layout_margin="12dp"
								android:gravity="center_horizontal|center_vertical"
								android:orientation="horizontal">
								<Switch
									android:id="@+id/switch1"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:padding="8dp"
									android:textSize="12sp"
									android:textColor="#000000" />
								<Button
									android:id="@+id/button6"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:layout_margin="5dp"
									android:padding="8dp"
									android:text="تفعيل ظهور الصور "
									android:textSize="30sp"
									android:textColor="#FFFFFF" />
							</LinearLayout>
								<Switch
									android:id="@+id/blur_switch"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:layout_margin="5dp"
									android:padding="8dp"
									android:text="تشويش الصور والفيديوهات"
									android:textSize="18sp"
									android:textColor="#FFFFFF"
									android:checked="true" />
								<Switch
									android:id="@+id/blur_video_switch"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:layout_margin="5dp"
									android:padding="8dp"
									android:text="تشويش الفيديوهات أيضًا"
									android:textSize="18sp"
									android:textColor="#FFFFFF"
									android:checked="true" />
								<TextView
									android:id="@+id/blur_amount_label"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:layout_margin="5dp"
									android:padding="8dp"
									android:text="درجة التشويش"
									android:textSize="16sp"
									android:textColor="#FFFFFF" />
								<SeekBar
									android:id="@+id/blur_amount"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:max="40"
									android:progress="10" />
								<TextView
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:layout_margin="5dp"
									android:padding="8dp"
									android:text="@string/mahjoob_settings_title"
									android:textColor="#FFFFFF"
									android:textSize="18sp" />
								<RadioGroup
									android:id="@+id/mahjoob_mode_group"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:orientation="vertical">
									<RadioButton
										android:id="@+id/mahjoob_mode_off"
										android:layout_width="match_parent"
										android:layout_height="wrap_content"
										android:text="@string/mahjoob_mode_off"
										android:textColor="#FFFFFF" />
									<RadioButton
										android:id="@+id/mahjoob_mode_women"
										android:layout_width="match_parent"
										android:layout_height="wrap_content"
										android:text="@string/mahjoob_mode_women"
										android:textColor="#FFFFFF" />
									<RadioButton
										android:id="@+id/mahjoob_mode_men"
										android:layout_width="match_parent"
										android:layout_height="wrap_content"
										android:text="@string/mahjoob_mode_men"
										android:textColor="#FFFFFF" />
									<RadioButton
										android:id="@+id/mahjoob_mode_everyone"
										android:layout_width="match_parent"
										android:layout_height="wrap_content"
										android:text="@string/mahjoob_mode_everyone"
										android:textColor="#FFFFFF" />
								</RadioGroup>
								<Switch
									android:id="@+id/mahjoob_strict_switch"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:layout_margin="5dp"
