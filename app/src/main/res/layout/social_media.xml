								android:id="@+id/textview6"
								android:layout_width="0dp"
								android:layout_height="0dp"
								android:padding="8dp"
								android:text="انقطع اتصالك بالانترنت "
								android:textSize="25sp"
								android:textColor="#FFFFFF" />
